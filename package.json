{
  "name": "sapc-intellysys",
  "version": "1.0.0",
  "private": true,
  "description": "SAPC IntellySys: Multi-Criteria Decision Support System for San Antonio de Padua College",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && .\\venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "build": "npm --prefix frontend install && npm --prefix frontend run build && node scripts/prepare-apphosting.js",
    "start": "node .next/standalone/server.js",
    "lint": "npm --prefix frontend run lint",
    "typescript": "npm --prefix frontend run typecheck",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:backend": "cd backend && .\\venv\\Scripts\\python -m pytest -v"
  },
  "workspaces": [
    "frontend"
  ],
  "keywords": [
    "decision-support-system",
    "ahp",
    "fastapi",
    "nextjs",
    "nlp"
  ],
  "author": "San Antonio de Padua College",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
