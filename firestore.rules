rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public / System Config
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Users Collection (RA 10173 Protected)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Students Cohort Records (Enables seamless multi-user CSV import & live dashboard sync)
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Academic & AHP Assessment Records
    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    // Daily Mood Check-ins
    match /mood_checkins/{checkinId} {
      allow read, write: if true;
    }

    // Guidance Intervention Plans
    match /interventions/{planId} {
      allow read, write: if true;
    }

    // Parent Notifications & SMS Logs
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Counselor Knowledge Base & AI Training Rules
    match /counselor_knowledge_base/{itemId} {
      allow read, write: if true;
    }

    // RA 10173 Immutable Audit Logs (Append-only audit integrity)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
