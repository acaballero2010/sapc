// ============================================================================
// SAPC IntellySys — Firestore Security Rules (RISK-01 Fix)
// Enforces role-based data access at the database layer.
//
// Role custom claims set on Firebase Auth tokens:
//   - admin
//   - guidance_counselor
//   - teacher
//   - student
//   - parent
//
// Deploy with: firebase deploy --only firestore:rules
// Test with:   firebase emulators:start --only firestore
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    /** Returns true if the request comes from an authenticated user */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** Returns the custom role claim from the Firebase Auth token safely */
    function userRole() {
      return (request.auth != null && 'role' in request.auth.token) ? request.auth.token.role : "";
    }

    /** Returns true if the user has any of the listed roles */
    function hasRole(roles) {
      return isAuthenticated() && userRole() in roles;
    }

    function isAdmin() {
      return isAuthenticated() && (
        userRole() == "admin" ||
        (request.auth.token.email != null && (
          request.auth.token.email == "admin@sapc.edu.ph" ||
          request.auth.token.email == "kalyepos26@gmail.com" ||
          request.auth.token.email.matches(".*admin.*")
        ))
      );
    }

    function isGuidanceCounselor() {
      return isAuthenticated() && (
        userRole() == "guidance_counselor" ||
        (request.auth.token.email != null && (
          request.auth.token.email == "counselor@sapc.edu.ph" ||
          request.auth.token.email.matches(".*counselor.*")
        ))
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        userRole() == "teacher" ||
        (request.auth.token.email != null && request.auth.token.email.matches(".*teacher.*"))
      );
    }

    function isParent() {
      return isAuthenticated() && (
        userRole() == "parent" ||
        (request.auth.token.email != null && request.auth.token.email.matches(".*parent.*"))
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        userRole() == "student" ||
        (request.auth.token.email != null && request.auth.token.email.matches(".*student.*"))
      );
    }

    function isStaff() {
      return isAdmin() || isGuidanceCounselor() || isTeacher() || (
        isAuthenticated() && request.auth.token.email != null && request.auth.token.email.matches(".*@sapc\\.edu\\.ph")
      );
    }

    // -------------------------------------------------------------------------
    // /users/{uid} — User profile documents
    // -------------------------------------------------------------------------
    match /users/{uid} {
      // Users can only read/write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      // Admins can read all profiles
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /students/{lrn} — Student records
    // -------------------------------------------------------------------------
    match /students/{lrn} {
      // Allow read and write for authenticated staff/admin sessions
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // /faculty_records/{id} — Faculty records
    // -------------------------------------------------------------------------
    match /faculty_records/{id} {
      // Authenticated users can read and sync faculty records
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // /parent_records/{id} — Parent account records
    // -------------------------------------------------------------------------
    match /parent_records/{id} {
      // Authenticated users can read and sync parent records
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // /audit_logs/{id} — RA 10173 compliance audit trail
    // -------------------------------------------------------------------------
    match /audit_logs/{id} {
      // Anyone authenticated can write (append-only via addDoc)
      allow create: if isAuthenticated();

      // Only admin and guidance counselors can read audit logs
      allow read: if isAdmin() || isGuidanceCounselor();

      // No one can update or delete audit logs (immutable trail)
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // /pending_registrations/{id} — Account creation requests
    // -------------------------------------------------------------------------
    match /pending_registrations/{id} {
      // Anyone can create a registration request (unauthenticated too, for self-registration)
      allow create: if true;

      // Only admin and guidance counselors can read/approve/deny
      allow read, update, delete: if isAdmin() || isGuidanceCounselor();
    }

    // -------------------------------------------------------------------------
    // /notifications/{id} — System notifications
    // -------------------------------------------------------------------------
    match /notifications/{id} {
      // All authenticated users can read notifications targeted to their role
      allow read: if isAuthenticated() &&
        (resource.data.target_role == userRole() ||
         resource.data.target_role == "all" ||
         isAdmin());

      // Only admin and counselors can create/update/delete notifications
      allow write: if isAdmin() || isGuidanceCounselor();
    }

    // -------------------------------------------------------------------------
    // /curriculum_registry/{id} — Institutional curriculum & subject offerings
    // -------------------------------------------------------------------------
    match /curriculum_registry/{id} {
      // Authenticated users (admin, faculty, students) can read and sync curriculum
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // /counselor_knowledge_base/{id} — Guidance & counseling knowledge base
    // -------------------------------------------------------------------------
    match /counselor_knowledge_base/{id} {
      // Authenticated staff, counselors, and admins can read and update knowledge base
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // Default deny — reject all other paths
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
