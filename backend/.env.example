# SAPC IntellySys Backend Configuration
PROJECT_NAME="SAPC IntellySys"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="sapc-intellysys-super-secret-key-change-in-production-2026"
